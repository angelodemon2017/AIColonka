  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: BackTalks_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9050bc0bb3464394bba037a42abe9577, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 73060229120
    m_Localized: And even now the war does not stop
    m_Metadata:
      m_Items: []
  - m_Id: 55318323200
    m_Localized: Over time, the sticks became stronger and more technologically advanced.
    m_Metadata:
      m_Items: []
  - m_Id: 31989604352
    m_Localized: Throughout history, people have measured themselves with sticks
    m_Metadata:
      m_Items: []
  - m_Id: 403056738607104
    m_Localized: Hey, hottie, do you want me to install an antivirus?
    m_Metadata:
      m_Items: []
  - m_Id: 403319268483072
    m_Localized: It's quite reckless to be here without a couple of guns.
    m_Metadata:
      m_Items: []
  - m_Id: 511646660993024
    m_Localized: The biggest mistake is to think that others think too...
    m_Metadata:
      m_Items: []
  - m_Id: 2592171542355968
    m_Localized: Wait! I need to check one more configuration!
    m_Metadata:
      m_Items: []
  - m_Id: 2592431907971072
    m_Localized: Great! Let's keep the fun going!
    m_Metadata:
      m_Items: []
  - m_Id: 3758748379111424
    m_Localized: Let's see what I haven't tested yet!
    m_Metadata:
      m_Items: []
  - m_Id: 4848761569271808
    m_Localized: We cleared out a bunch of trash, I hope now he will help me and
      I will return to the hub
    m_Metadata:
      m_Items: []
  - m_Id: 4853743567757312
    m_Localized: Damn! Missed again! At least I managed to get away from that paranormal...
    m_Metadata:
      m_Items: []
  - m_Id: 4856129338204160
    m_Localized: And whose server is this, so busy?
    m_Metadata:
      m_Items: []
  - m_Id: 5173395972595712
    m_Localized: Phew, we did it, now we can sort out the order
    m_Metadata:
      m_Items: []
  - m_Id: 5447640174731264
    m_Localized: '*THUSH* Your tricks don''t work on me'
    m_Metadata:
      m_Items: []
  - m_Id: 5450518763315200
    m_Localized: '*THUNDER*-*THUNDER* My subconscious is not a hindrance to me'
    m_Metadata:
      m_Items: []
  - m_Id: 5452044814688256
    m_Localized: Why has it become so empty here...
    m_Metadata:
      m_Items: []
  - m_Id: 5454444124348416
    m_Localized: First, you need to synchronize with home
    m_Metadata:
      m_Items: []
  - m_Id: 5458476276555776
    m_Localized: This is power!
    m_Metadata:
      m_Items: []
  - m_Id: 5888237531815936
    m_Localized: I don't have enough strength for this yet
    m_Metadata:
      m_Items: []
  - m_Id: 6587208881397760
    m_Localized: It feels like I left here yesterday
    m_Metadata:
      m_Items: []
  - m_Id: 10920845114335232
    m_Localized: Checking documents
    m_Metadata:
      m_Items: []
  - m_Id: 10973463677231104
    m_Localized: Hold on Astra, it's almost like surfing... I guess...
    m_Metadata:
      m_Items: []
  - m_Id: 11233962168590336
    m_Localized: You just have to try
    m_Metadata:
      m_Items: []
  - m_Id: 11372823518896128
    m_Localized: You just have to aim
    m_Metadata:
      m_Items: []
  - m_Id: 11373079467909120
    m_Localized: It should work now!
    m_Metadata:
      m_Items: []
  - m_Id: 11381476737146880
    m_Localized: We need to put an end to this.
    m_Metadata:
      m_Items: []
  - m_Id: 5801603109658624
    m_Localized: What does my consciousness consist of...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
